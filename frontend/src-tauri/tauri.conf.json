{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Avalon",
  "version": "0.1.0",
  "identifier": "com.avalon.llamadash",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime/sidecars/": "sidecars/",
      "icons/tray.png": "tray.png"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
