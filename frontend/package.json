{
  "name": "avalon",
  "private": true,
  "version": "0.1.0",
  "description": "Avalon local LLM dashboard and authenticated gateway",
  "author": "Avalon contributors",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "prepare:sidecars": "python ../packaging/ensure_sidecars.py",
    "dev:app": "npm run tauri -- dev",
    "pack": "npm run prepare:sidecars && npm run tauri -- build --bundles app",
    "dist": "npm run prepare:sidecars && npm run tauri -- build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.14"
  }
}
